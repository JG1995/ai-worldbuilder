{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grimoire.md",
  "mainBinaryName": "grimoire",
  "version": "../package.json",
  "identifier": "io.github.jg1995.grimoire",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grimoire.md",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/assets/licenses/darker-grotesque-OFL.txt": "licenses/darker-grotesque-OFL.txt",
      "../src/assets/licenses/hanken-grotesk-OFL.txt": "licenses/hanken-grotesk-OFL.txt",
      "../src/assets/licenses/material-symbols-LICENSE.txt": "licenses/material-symbols-LICENSE.txt"
    }
  }
}
