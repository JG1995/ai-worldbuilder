{
  "name": "grimoire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "pipx run tools/subset-icons.py",
    "bindings": "node tools/bindings.mjs",
    "check": "pnpm check:biome && pnpm check:tsc && pnpm check:secrets && pnpm build && pnpm check:dist && pnpm check:bindings && pnpm test && pnpm test:e2e && pnpm check:rustfmt && pnpm check:clippy && pnpm check:cargo-test",
    "check:biome": "biome check",
    "check:bindings": "node tools/bindings.mjs --check",
    "check:tsc": "tsc -b",
    "check:secrets": "secretlint \"**/*\" --secretlintignore .gitignore",
    "check:dist": "node tools/check-dist.mjs",
    "check:rustfmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check:cargo-test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/darker-grotesque": "5.3.0",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.105.0",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.3",
    "material-symbols": "0.48.2",
    "secretlint": "^13.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
